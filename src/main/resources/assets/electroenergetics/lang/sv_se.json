  "electroenergetics.ponder.switch.header": "Använda en brytare",
  "electroenergetics.ponder.switch.text_1": "Brytare kan användas för att avbryta strömflödet",
  "electroenergetics.ponder.tag.electric_train_sound_changing": "Ljudändrare för elektriska tåg",
  "electroenergetics.ponder.tag.electric_train_sound_changing.description": "Dessa block ändrar ljudet på elektriska tåg.",
  "electroenergetics.ponder.tag.electrical": "Elektriska komponenter",
  "electroenergetics.ponder.tag.electrical.description": "Komponenter som använder elektricitet",
  "electroenergetics.ponder.tag.electricity_basics": "Grundläggande elektricitet",
  "electroenergetics.ponder.tag.electricity_basics.description": "Hur elektricitet fungerar",
  "electroenergetics.ponder.third_rail.header": "Använda strömskena",
  "electroenergetics.ponder.third_rail.text_1": "Elektriska tåg kan samla ström från en strömskena (tredje räl)",
  "electroenergetics.ponder.third_rail.text_2": "Använd en strömskenekontakt för det ändamålet",
  "electroenergetics.ponder.transformer.header": "Ändra spänningar",
  "electroenergetics.ponder.transformer.text_1": "Transformers kan användas för att ändra spänning.",
  "electroenergetics.ponder.transformer.text_2": "Ställ helt enkelt in förhållandet.",
  "electroenergetics.ponder.transformer_core_multiblock.header": "Grundläggande om transformatorkärnor",
  "electroenergetics.ponder.transformer_core_multiblock.text_1": "Transformatorkärnor kan konfigureras med ett specifikt antal varv.",
  "electroenergetics.ponder.transformer_core_multiblock.text_2": "Omge transformatorkärnan med radiatorpaneler och täck den med transformatorolja för att öka dess effekttålighet",
  "electroenergetics.ponder.transformer_core_multiblock.text_3": "Att överskrida transformatorns effekttålighet kommer att göra att den överbelastas.",
  "electroenergetics.ponder.transformer_losses.header": "Transformatorer och energiförluster",
  "electroenergetics.ponder.transformer_losses.text_1": "Kablar har ett visst motstånd, därför orsakar de energiförluster.",
  "electroenergetics.ponder.transformer_losses.text_2": "299.5V",
  "electroenergetics.ponder.transformer_losses.text_3": "299.4V",
  "electroenergetics.ponder.transformer_losses.text_4": "10A",
  "electroenergetics.ponder.transformer_losses.text_5": "Energiförluster är direkt proportionella mot motståndet och kvadraten på strömstyrkan.",
  "electroenergetics.ponder.transformer_losses.text_6": "Transformers kan användas för att öka spänningen, och därför minska strömstyrkan.",
  "electroenergetics.ponder.transformer_losses.text_7": "3.3A",
  "electroenergetics.ponder.transformer_losses.text_8": "För stora kraftledningar kan upptransformering av spänningen avsevärt minska energiförlusterna.",
  "electroenergetics.ponder.transformer_turns.header": "Hur transformatorer fungerar",
  "electroenergetics.ponder.transformer_turns.text_1": "Transformers används för att transformera upp eller transformera ner spänning",
  "electroenergetics.ponder.transformer_turns.text_2": "Lägg märke till hur varvförhållandet är lika med spänningsförhållandet",
  "electroenergetics.ponder.transformer_turns.text_3": "Dessutom kopplar inte transformatorn ihop de båda kretsarna",
  "electroenergetics.ponder.transformer_turns.text_4": "Istället kopplar den dem magnetiskt",
  "electroenergetics.ponder.voltage_introduction.header": "Vad är spänning?",
  "electroenergetics.ponder.voltage_introduction.text_1": "Spänning är måttet på skillnaden i elektrisk potential",
  "electroenergetics.ponder.voltage_introduction.text_2": "Voltmetern mäter spänningsskillnaden mellan de två punkterna.",
  "electroenergetics.ponder.voltage_introduction.text_3": "Kom ihåg att det inte finns något strömflöde än!",
  "electroenergetics.ponder.voltage_introduction.text_4": "Tänk på spänning som trycket som driver strömflödet.",
  "electroenergetics.ponder.voltage_introduction.text_5": "För närvarande flyttas ingen energi, eftersom det inte finns något strömflöde.",
  "electroenergetics.ponder.voltage_introduction.text_6": "Efter att ha anslutit en belastning till kretsen börjar strömmen flyta",
  "electroenergetics.ponder.voltage_introduction.text_7": "Ju högre spänning, desto mer ström flyter det",
  "electroenergetics.ponder.voltage_regulator.header": "Reglera spänning med en spänningsregulator",
  "electroenergetics.ponder.voltage_regulator.text_1": "En voltage regulator kan användas för att reglera spänningen dynamiskt",
  "electroenergetics.ponder.voltage_regulator.text_2": "Anslut strömkällan till ingångsterminalen på ovansidan",
  "electroenergetics.ponder.voltage_regulator.text_3": "Anslut den negativa till jordterminalen på undersidan",
  "electroenergetics.ponder.voltage_regulator.text_4": "Anslut belastningen till utgångsterminalen",
  "electroenergetics.ponder.voltage_regulator.text_5": "Slutligen, sluta kretsen",
  "electroenergetics.ponder.voltage_regulator.text_6": "Spänningsregulatorn kommer att justera utspänningen så att den är så nära 300V som möjligt",
  "electroenergetics.ponder.wire_attachments.header": "Kabeltillbehör",
  "electroenergetics.ponder.wire_attachments.text_1": "Vissa föremål kan hängas på kablar",
